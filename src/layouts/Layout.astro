---
import "../styles/global.css";
import { SEO } from "astro-seo";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "thoip.web.id — Jasa Pembuatan Website Profesional",
	description = "thoip.web.id menyediakan jasa pembuatan website profesional untuk bisnis dan UMKM.",
} = Astro.props;
---

<!doctype html>
<html lang="id">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />

		<SEO
			title={title}
			description={description}
			canonical={Astro.url}
			openGraph={{
				basic: {
					title,
					type: "website",
					image: "https://thoip.web.id/og-image.jpg",
					url: Astro.url.href,
				},
				optional: {
					description,
					siteName: "thoip.web.id",
					locale: "id_ID",
				},
			}}
		/>

		<!-- fonts dll -->
	</head>

	<body class="bg-slate-50 font-sans text-slate-900 antialiased">
		<slot />
	</body>
</html>